{
  "name": "gradient",
  "private": true,
  "type": "module",
  "bin": { "gradient": "apps/cli/src/main.ts" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun apps/cli/src/main.ts dev",
    "build": "bun run --filter '@gradient/server' --filter '@gradient/web' build",
    "start": "bun apps/cli/src/main.ts start --web",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "7.0.2"
  }
}
